              "rotation": 0,
              "opacity": 1,
              "locked": false,
              "visible": true,
              "groupPath": [],
              "text": "Please read this instruction manual carefully before using the product and keep it properly.",
              "fontFamily": "MiSans",
              "fontWeight": 600,
              "fontSize": 29.166666666666668,
              "lineHeight": 1.1428571428571428,
              "letterSpacing": 0,
              "paragraphSpaceBefore": 0,
